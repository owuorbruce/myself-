{
  "name": "slate-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "start": "node run-slate.mjs",
    "desktop": "electron desktop",
    "package:windows": "npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "test:desktop-package": "node desktop/check-package.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-details": "^3.31.4",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.0",
    "turndown": "^7.2.0",
    "vite-plugin-pwa": "^1.0.0"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
